{
  "schemaVersion": 1,
  "id": "generic",
  "name": "Genel düz G-code",
  "version": "1.0.0",
  "status": "unverified",
  "notes": "Safe, conservative plain RS-274 G-code (spec §6.4 default). Unverified until field test 1. IJ incremental is the RS-274 default; G91.1 is not written because Fanuc-style controllers reject it (D-025, open question).",
  "program": {
    "prefix": [],
    "start": [],
    "end": ["M30"],
    "suffix": []
  },
  "comments": { "style": "paren", "asciiOnly": true, "maxLength": 120 },
  "lineNumbers": { "enabled": false, "start": 10, "increment": 10, "max": 99999 },
  "modal": { "words": ["G21", "G90", "G17", "G54"] },
  "toolChange": {
    "mode": "auto",
    "manualStop": "M0",
    "lengthOffset": false,
    "pauseForFirstTool": false
  },
  "spindle": { "on": "M3", "off": "M5", "speedPosition": "after", "rpmDecimals": 0 },
  "dwell": { "word": "P", "unit": "s", "decimals": 1 },
  "motion": {
    "rapid": "G0",
    "linear": "G1",
    "cw": "G2",
    "ccw": "G3",
    "suppressRepeatedCode": false,
    "suppressUnchangedAxes": true
  },
  "decimals": { "xy": 3, "z": 3, "arc": 3, "feed": 0 },
  "arcs": {
    "enabled": true,
    "mode": "ijIncremental",
    "distanceModeWord": null,
    "fullCircle": false,
    "helical": true,
    "maxSweepDeg": 180,
    "chordTolerance": 0.01
  },
  "drill": { "cycles": "none" },
  "vacuum": { "enabled": true },
  "file": {
    "extension": "nc",
    "maxNameLength": 64,
    "lineEnding": "crlf",
    "maxSizeBytes": 10485760,
    "onOversize": "split"
  }
}
